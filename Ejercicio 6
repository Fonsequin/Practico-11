#include <iostream>
using namespace std;
 //< >
class Animal
{
    protected:
    char nombre[40];
    public:
    Animal()
    {
        cargar();
    }
    void cargar(){
        cout << "Ingrese el nombre del animal: ";
        cin.getline(nombre,40);
        cout << endl;
    }
    void hacerRuido()
    {
        cout << "ruido";
    }
    void comer()
    {
        cout << "comer";
    }
    void imprimir()
    {
        cout << "El nombre del animal es: " << nombre << endl;
    }
};

class Perro : public Animal
{
    public:
    void hacerRuido()
    {
        cout << "Este animal hace woof" << endl;
    }
    void comer()
    {
        cout << "Este animal come todo tipo de carnes" << endl;
    }
};

